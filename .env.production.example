# Этот файл содержит безопасные настройки и невалидные placeholders.
# Он не проходит проверку запуска, пока значения не заменены.
# Рабочий production env-файл хранится вне репозитория с правами 0600.

# Доверяйте только фактическим адресам или сетям reverse proxy.
GENERATION_TRUSTED_PROXIES=replace-with-trusted-proxy-address-or-cidr

# Защита частоты и общий предохранитель. Значения выбираются по допустимому расходу.
GENERATION_CLIENT_COOKIE_SECRET=replace-with-random-secret-at-least-32-characters
GENERATION_IP_REQUEST_LIMIT=replace-with-positive-integer
GENERATION_IP_WINDOW_MS=replace-with-positive-integer
GENERATION_CLIENT_DAILY_LIMIT=replace-with-positive-integer
GENERATION_RATE_LIMIT_STATE_CAPACITY=replace-with-positive-integer
GENERATION_ENABLED=false
GENERATION_GLOBAL_DAILY_LIMIT=replace-with-positive-integer
GENERATION_GLOBAL_CONCURRENCY_LIMIT=replace-with-positive-integer

# Production использует обязательную CAPTCHA. Ключи создаются вне репозитория.
SMARTCAPTCHA_MODE=required
SMARTCAPTCHA_CLIENT_KEY=replace-with-public-client-key
SMARTCAPTCHA_SERVER_KEY=replace-with-private-server-key

# Выбранная production-модель: YandexGPT 5.1 Pro, только Responses.
# До установки фактических значений нужны допуск #181 и проверка переноса #206.
# Полный идентификатор выбранной версии хранится только в закрытом env-файле.
# Не подменяйте его моделью по умолчанию или плавающим псевдонимом.
LLM_API_PROTOCOL=responses
LLM_API_URL=https://provider.example/v1/responses
LLM_API_KEY=replace-with-private-api-key
LLM_AUTH_SCHEME=Api-Key
LLM_MODEL=replace-with-qualified-model-id
LLM_PROVIDER=yandex
# При необходимости одобренной конфигурации задайте LLM_FOLDER_ID вне Git.
# Лимит ответа берётся из production gateway: 4000, не из benchmark-конфигурации.
