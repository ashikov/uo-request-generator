{
  "name": "uo-request-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=26.3.0 <27",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @uo-request-generator/web dev",
    "build": "pnpm --filter @uo-request-generator/core build && pnpm --filter @uo-request-generator/llm build && pnpm --filter @uo-request-generator/web build",
    "start": "pnpm --filter @uo-request-generator/web start",
    "smoke:llm": "pnpm --filter @uo-request-generator/web smoke:llm",
    "benchmark:llm": "pnpm --filter @uo-request-generator/web benchmark:llm",
    "test:production-runtime": "bash scripts/test-production-runtime.sh",
    "lint": "biome lint .",
    "lint:md": "markdownlint-cli2",
    "check:file-endings": "node scripts/check-file-endings.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm --recursive --if-present typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "check:quality": "pnpm format:check && pnpm lint && pnpm lint:md && pnpm check:file-endings && pnpm typecheck",
    "check": "pnpm check:quality && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.0",
    "markdownlint-cli2": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
